# Go service loads .env from its working directory; existing environment values take precedence.
# Compose keeps its own HOST/PORT/DATABASE_PATH; CHECK_* can be set here for either mode.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/lottery.sqlite
CHECK_ENABLED=true
# Five-field cron expressions separated by semicolons; includes midnight, excludes 00:20.
CHECK_SCHEDULE="*/20 22-23 * * *;0 0 * * *"
CHECK_TIMEZONE=Asia/Shanghai
